        "success": {
          "item": { "remove": { "battery": 1 } },
          "damage": { "who": "nearest", "n": 2, "amount": 2 },
          "say": ["You short the cell into the water. Two bodies jerk."]
        },
        "fail": {
          "item": { "remove": { "battery": 1 } },
          "say": ["The cell fizzes and dies."]
        }
      }
    }
  },
